{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/inox/.config/fastfetch/png/arch.png",
    "height": 7,
    "width": 14,
    "padding": {
      "top": 1,
      "right": 1
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────────────────────┐"
    },
    {
      "type": "title",
      "format": "  {user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "31" // Màu hồng pastel nhạt
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "34" // Màu tím xanh pastel (Đổi sang màu khác OS)
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "33" // Màu vàng kem nhạt
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "32" // Màu xanh mint nhạt
    },
    {
      "type": "uptime",
      "key": "  Uptime",
      "keyColor": "35" // Màu hồng phấn / Tím khói
    },
    {
      "type": "packages",
      "key": "  Packages",
      "keyColor": "36" // Màu xanh băng nhạt
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 6,
      "symbol": "circle"
    }
  ]
}
